{
  "manifest_version": 3,
  "name": "DAP Coach",
  "version": "1.2.0",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8710/*",
    "http://127.0.0.1:8710/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://localhost:8000/*", "http://127.0.0.1:8000/*"],
      "js": ["overlay.js", "engine.js", "recorder.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
