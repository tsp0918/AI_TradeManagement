# ============================================================
# Platform Core 共通設定
# このファイルをコピーして .env を作成してください
# cp .env.example .env
# ============================================================

# --- Database ---
PLATFORM_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/platform_db

# 各モジュール用 (開発時は同一DBを使用)
VALIDATION_DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/platform_db
CLASSIFICATION_DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/platform_db
RND_DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/platform_db
PATENT_DATABASE_URL=sqlite:///./patent.db
DAP_DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/platform_db

# --- Internal Service (モジュール間通信) ---
INTERNAL_SERVICE_KEY=your-internal-key-min-32-chars-here
PLATFORM_CORE_URL=http://localhost:8000

# --- JWT ---
JWT_SECRET_KEY=your-secret-key-min-32-chars-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Google OAuth2 (SSO) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- Microsoft OAuth2 (SSO) ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI=http://localhost:8000/auth/microsoft/callback

# --- LLM Gateway ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_LLM_PROVIDER=anthropic
DEFAULT_LLM_MODEL=claude-sonnet-4-6

# --- File Storage ---
# local | s3
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=

# --- Module URLs (開発時はlocalhost) ---
MODULE_AI_VALIDATION_URL=http://localhost:8001
MODULE_AI_CLASSIFICATION_URL=http://localhost:8002
MODULE_RND_ASSESSMENT_URL=http://localhost:8003
MODULE_PATENT_SEARCH_URL=http://localhost:8004
MODULE_SCREENING_URL=http://localhost:8005

# --- Platform ---
PLATFORM_ENV=development
PLATFORM_LOG_LEVEL=INFO
